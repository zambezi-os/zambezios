# ZambeziOS fragment on top of qemu_aarch64_virt_defconfig
BR2_TARGET_GENERIC_HOSTNAME="zambezios"
BR2_TARGET_GENERIC_ISSUE="ZambeziOS"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ZAMBEZIOS_PATH)/board/zambezios/post-build.sh"
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_REPRODUCIBLE=y
